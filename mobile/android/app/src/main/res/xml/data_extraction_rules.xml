<?xml version="1.0" encoding="utf-8"?>
<!--
  No app data is copied to cloud backups or to a new device. Session tokens
  (secure storage) cannot be restored on another device anyway, and learner
  state lives on the server. Local practice data is intentionally excluded
  too: it is not an official record.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
